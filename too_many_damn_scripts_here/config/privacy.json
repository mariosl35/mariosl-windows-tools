[
{
    "schemaVersion": 1,
    "id": "privacy.disable-advertising-id",
    "displayName": "Disable Advertising ID",
    "requiresElevation": true,
    "description": "Prevents Windows from using your advertising ID for personalized experiences across apps.",
    "category": "Privacy",
    "riskLevel": "Low",
    "rollbackCapability": "full",
    "requiresRestart": "none",
    "target": {
        "type": "registry",
        "operation": "set",
        "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
        "name": "Enabled",
        "valueType": "DWord",
        "desiredValue": 0
}
    },
	{
